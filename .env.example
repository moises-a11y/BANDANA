# Token de acceso de Mercado Pago.
# Se obtiene en: Tus integraciones > Credenciales > Access Token.
# Producción empieza con APP_USR-...  |  Pruebas empieza con TEST-...
MP_ACCESS_TOKEN=

# Puerto del servidor Express (opcional, por defecto 3000).
PORT=3000

# URL base de la API de Mercado Pago (opcional).
MP_BASE_URL=https://api.mercadopago.com
